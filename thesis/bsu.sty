% Список литературы как обычный нумерованный список (в виде абзацев)
\newenvironment{biblio}{%
  \clearpage
  \addcontentsline{toc}{chapter}{СПИСОК ИСПОЛЬЗОВАННЫХ ИСТОЧНИКОВ}%
  {%
    \centering
    \parindent=0pt
    \normalfont\bfseries\fontsize{16pt}{18pt}\selectfont
    СПИСОК ИСПОЛЬЗОВАННЫХ ИСТОЧНИКОВ\par
  }%
  \addvspace{36pt}% отступ после заголовка
  \begin{list}{\arabic{enumi}.}{\usecounter{enumi}
    \setlength{\leftmargin}{0pt}         % Вторая и последующие строки идут строго по левому краю
    \setlength{\itemindent}{\myparindent}% Первая строка с номером начинается с абзацного отступа
    \setlength{\itemsep}{0pt}            % Нормальный интервал между записями
  }
}{%
  \end{list}
}


