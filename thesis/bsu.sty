%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% СТРУКТУРНЫЕ ЧАСТИ (С КОРРЕКТНЫМИ И РАЗЛИЧИМЫМИ РАЗМЕРАМИ ШРИФТОВ)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\RequirePackage{titlesec}

\newcommand{\chapterbreak}{\clearpage}

% ГЛАВА: строго 16pt (на 2 пункта больше основного 14pt, по методичке)
\titleformat{\chapter}[display]{\bfseries\fontsize{16pt}{18pt}\selectfont\centering}{ГЛАВА \ \thechapter}{0em}{}
\titlespacing{\chapter}{0em}{-1.5em}{0em} 

\makeatletter

% АВТО-ВЫРАВНИВАНИЕ: Перехватываем \chapter* и вшиваем туда \addvspace{36pt}
\let\oldchapter\chapter
\renewcommand{\chapter}{%
  \@ifstar{\@starredchapter}{\oldchapter}%
}
\newcommand{\@starredchapter}[1]{%
  \oldchapter*{#1}%
  \par\addvspace{36pt}%
}

% Формат номера раздела/подраздела: БЕЗ точки, с пробелом
\renewcommand*{\@seccntformat}[1]{%
  \csname the#1\endcsname\quad
}

% РАЗДЕЛ
\renewcommand{\section}[1]{%
  \refstepcounter{section}%
  \addcontentsline{toc}{section}{\thesection\quad #1}%
  \par\vspace{24pt}% 
  {%
    \normalfont\bfseries\fontsize{16pt}{18pt}\selectfont\RaggedRight % <-- Заменили на \RaggedRight
    \noindent\hspace*{\myparindent}\@seccntformat{section}#1\par 
  }%
  \vspace{24pt}% 
}

% ПОДРАЗДЕЛ: разумный компромисс
\renewcommand{\subsection}[1]{%
  \refstepcounter{subsection}%
  \addcontentsline{toc}{subsection}{\thesubsection\quad #1}%
  \par\vspace{24pt}% <-- 24pt до заголовка
  {%
    \normalfont\bfseries\fontsize{14pt}{18pt}\selectfont\raggedright
    \noindent\hspace*{\myparindent}\@seccntformat{subsection}#1\par 
  }%
  \vspace{24pt}% <-- 24pt после заголовка
}

% Раздел приложения (А.1, А.2 и т.д.)
\newcommand{\appsection}[2]{%
  \addcontentsline{toc}{section}{#1~#2}%
  \par\vspace{24pt}% <-- 24pt до заголовка
  {%
    \normalfont\bfseries\fontsize{16pt}{18pt}\selectfont
    \sloppy % <-- Разрешаем свободный перенос длинных слов и названий файлов
    \noindent\hspace*{\myparindent}#1~#2\par
  }%
  \vspace{24pt}% <-- 24pt после заголовка
}

